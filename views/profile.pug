extends ./layouts/layout.pug

block content
  h1.form__title Profile
  div.panel.profile-grid
    .profile-label #[strong Username]
    .profile-value= user.username

    .profile-label #[strong Member since]
    .profile-value= user.createdAt

    .profile-label #[strong Last updated]
    .profile-value= user.updatedAt

    form(method="POST", action="/auth/logout")
      button(type="submit") Logout