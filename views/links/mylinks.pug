extends ../layouts/layout.pug

block content 
  div.panel
    h1.form__title My Short Links

    if !links
      p No links have been created so far

    if error
      p.error= error
    
    else
      ul.link-list
        each link in links
          li
            
            div.link-item
              a(href="/links/" + link.id)= link.alias
              |  → #{link.url}
              br
              | #[strong ID]: #{link.id}
              br
              | #[strong Clicks]: #{link.clickCount}
              br
              - const isExpired = link.expiresAt ? new Date(link.expiresAt).getTime() <= Date.now() : false
              - const qrAddress = isExpired ? null : `/links/${link.alias}/qr`
              if qrAddress 
                a(href= qrAddress) Get Code
              else
                p.error Link expired.