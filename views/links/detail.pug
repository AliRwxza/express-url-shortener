extends ../layout.pug

block content
  div.panel
    h1 Link Details

    if error
      p.error= error

    else
      p Alias: #{link.alias}

      p Original URL:
        a(href=link.url)= link.url

      p Clicks: #{link.clickCount}

      if link.expiresAt
        p Expires at: #{link.expiresAt}
      
 
      p Events recorded for #{link.alias}
      ul.link-list
        each event in clickEvents
          li
            div.link-item
              | #[strong IP]  #{event.ipAddress}
              br
              | #[strong Agent]  #{event.userAgent}
              br
              | #[strong Referer]  #{event.referrer}
            hr