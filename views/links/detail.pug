extends ../layouts/layout.pug

block content
  div.panel
    h1 Link Details

    if error
      p.error= error

    else
      .detail-grid
        .detail-label Alias
        -const url = "http://localhost:3000/"+link.alias
        a(href=url).detail-value= link.alias

        .detail-label Original URL
        .detail-value #[a(href=link.url)= link.url]

        .detail-label Clicks
        .detail-value= link.clickCount

        - const expires = link.expiresAt || "never"
        .detail-label Expires at
        .detail-value= expires

        - const eventCount = clickEvents ? clickEvents.length : 0;
        .detail-label Events recorded
        .detail-value= eventCount
      ul.link-list
        each event in clickEvents
          li
            div.link-item.link-item-grid

              .link-item-label IP
              .link-item-value= event.ipAddress

              .link-item-label User 
              .link-item-value= event.userAgent 

              -const referrer = event.referrer || "None"
              .link-item-label Referrer 
              .link-item-value= referrer