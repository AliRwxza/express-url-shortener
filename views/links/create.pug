extends ../layout.pug

block content
  div.panel
    h1.form__title Create a short link

    if error
      p.error= error
    
    if confirm 
      p.confirm= confirm
    
    form(method="POST", action="/links/create")

      div
        label(for="url") URL
        br
        input.form__input(
          type="url",
          id="url",
          name="url",
          placeholder="https://example.com",
          required
        )
      
      div
        label(for="givenAlias") Custom Alias (optional)
        br
        input.form__input(
          type="text",
          id="givenAlias",
          name="givenAlias",
          placeholder="CustomAlias123"
        )
      
      div.form__field
        label(for="expiry") Expiration (in seconds, optional)
        br
        input.form__input(
          type="text",
          id="expiry",
          name="expiry",
          step="1",
          min="0",
          placeholder="3600"
        )

      button.form__button(type="submit") Create Link